; ================================
; Production MD
; Length set by run_pipeline.py --prod-ns argument
; ================================
integrator              = md
dt                      = 0.002
nsteps                  = {NSTEPS}      ; set dynamically: prod_ns * 500000
nstxout-compressed      = 5000
nstenergy               = 5000
nstlog                  = 5000
compressed-x-grps       = System

continuation            = yes
constraint_algorithm    = lincs
constraints             = h-bonds
lincs_iter              = 1
lincs_order             = 4

cutoff-scheme           = Verlet
nstlist                 = 20
ns_type                 = grid
pbc                     = xyz

coulombtype             = PME
rcoulomb                = 1.2
vdwtype                 = Cut-off
vdw-modifier            = Force-switch
rvdw-switch              = 1.0
rvdw                    = 1.2
DispCorr                = no
pme_order               = 4
fourierspacing          = 0.16

tcoupl                  = V-rescale
tc-grps                 = Protein_LIG  Water_and_ions
tau_t                   = 0.1          0.1
ref_t                   = 300          300

pcoupl                  = C-rescale
pcoupltype              = isotropic
tau_p                   = 2.0
ref_p                   = 1.0
compressibility         = 4.5e-5

gen_vel                 = no
