; Minimal mdp just to build a .tpr for genion (no actual dynamics run)
integrator      = steep
emtol           = 1000.0
emstep          = 0.01
nsteps          = 0

cutoff-scheme   = Verlet
nstlist         = 10
ns_type         = grid
coulombtype     = PME
rcoulomb        = 1.2
rvdw            = 1.2
pbc             = xyz
